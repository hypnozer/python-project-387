{
  "name": "calendar-booking-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "generate:api": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts",
    "typecheck": "tsc --noEmit",
    "build": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.d.ts && tsc -b && vite build",
    "test:e2e": "playwright test",
    "preview": "vite preview"
  },
  "dependencies": {
    "lucide-react": "1.37.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "7.18.3"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "6.1.1",
    "openapi-typescript": "7.13.0",
    "typescript": "5.9.3",
    "vite": "8.2.2"
  }
}
